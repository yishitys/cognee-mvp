# Copy this file to .env and fill in your provider key before running cognee.
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-5-mini
LLM_API_KEY=your_api_key_here

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_API_KEY=your_api_key_here

# Keep cognee state inside this project instead of inside site-packages.
# Cognee 1.1.x requires absolute paths for these directories.
DATA_ROOT_DIRECTORY=C:/programming/playground/hackthon/.data_storage
SYSTEM_ROOT_DIRECTORY=C:/programming/playground/hackthon/.cognee_system
CACHE_ROOT_DIRECTORY=C:/programming/playground/hackthon/.cognee_cache

# Local defaults. For production or multiple worker processes, prefer a running
# cognee API server or external stores such as Postgres/pgvector and Neo4j.
GRAPH_DATABASE_PROVIDER=ladybug
VECTOR_DB_PROVIDER=lancedb
DB_PROVIDER=sqlite

# Helps serialize dataset operations when multiple agents may write at once.
DATASET_QUEUE_ENABLED=true
DATASET_QUEUE_MAX_CONCURRENT=4
